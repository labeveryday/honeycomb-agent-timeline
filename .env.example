# Needed for live runs. Use a model ID from your Anthropic account, like claude-sonnet-5-5.
ANTHROPIC_API_KEY=
MODEL=YOUR_CLAUDE_MODEL_ID
# Optional. Leave blank to keep traces on your machine.
HONEYCOMB_API_KEY=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.honeycomb.io/v1/traces
# Honeycomb accounts in the EU: https://api.eu1.honeycomb.io/v1/traces
# Records prompts and tool results in traces. The lab data is fake. Keep real secrets out.
CAPTURE_CONTENT=true
